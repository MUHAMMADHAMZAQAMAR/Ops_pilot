# ====================================================================
# BACKEND ZERO-TRUST AI AUTOMATION ENGINE ENVIRONMENT CONFIGURATION
# ====================================================================

# Server Settings
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Supabase Auth & Multi-Tenant Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.wvqpsnpmvdxeojxwbdje:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.wvqpsnpmvdxeojxwbdje:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# AI Execution Engine (OpenAI API with Structured Outputs)
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-2024-08-06

# Cryptographic Human-in-the-Loop (HITL) Gate Secrets
APPROVAL_JWT_SECRET=super-secret-cryptographic-approval-key-minimum-32-chars-long
APPROVAL_TOKEN_TTL_SECONDS=86400

# Upstash Redis (Sliding-window Rate Limiting & Distributed Mutex Locks)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Security Firewall Settings
FIREWALL_STRICT_MODE=true
FIREWALL_ENTROPY_THRESHOLD=5.5

